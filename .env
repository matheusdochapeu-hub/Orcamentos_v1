# Configurações do sistema — copie de .env.example e preencha

# ── Google Maps API Key (OBRIGATÓRIO para busca de empresas) ──
# Obtenha em: https://console.cloud.google.com
# Ative estas APIs no projeto:
#   - Maps JavaScript API
#   - Places API
#   - Geocoding API
GOOGLE_MAPS_API_KEY=SUA_CHAVE_AQUI

# ── Gemini API Key (OPCIONAL — melhora busca CATMAT/CATSER) ──
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Servidor ──
HOST=0.0.0.0
PORT=8000
DEBUG=true
