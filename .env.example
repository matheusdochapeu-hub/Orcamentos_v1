# Copie este arquivo para .env e preencha o que precisar.

# ─── Busca de empresas ─────────────────────────────────────────────────────
# Fonte padrão de empresas. A busca funciona SEM Google Maps usando a base
# CNPJ da Receita Federal (filtro por CNAE + município + UF).
#
# RECEITA_BACKEND escolhe qual API pública consultar primeiro:
#   casadosdados | cnpja | custom     (fallback automático entre elas)
RECEITA_BACKEND=casadosdados

# Endpoints dos backends (só mexa se precisar apontar para outro serviço /
# self-host como o "minhareceita"). Deixe em branco para usar o padrão.
# RECEITA_CASADOSDADOS_URL=https://api.casadosdados.com.br/v2/public/cnpj/search
# RECEITA_CNPJA_URL=https://api.cnpja.com/office
# RECEITA_CUSTOM_URL=

# ─── Google Maps API Key (OPCIONAL) ────────────────────────────────────────
# Só é necessária se você escolher a fonte "Google Maps" ou "Ambas" na tela.
# Obtenha em: https://console.cloud.google.com
# Ative: Geocoding API e Places API
GOOGLE_MAPS_API_KEY=

# ─── Gemini API Key (opcional - melhora a busca CATMAT/CATSER) ──────────────
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Configurações do servidor ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
