# Copie este arquivo para .env e preencha suas chaves

# Google Maps API Key (obrigatório para busca de empresas)
# Obtenha em: https://console.cloud.google.com
# Ative: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=SUA_CHAVE_AQUI

# Gemini API Key (opcional - melhora a busca CATMAT/CATSER)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Configurações do servidor
HOST=0.0.0.0
PORT=8000
DEBUG=true
